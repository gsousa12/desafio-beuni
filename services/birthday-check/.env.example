# ==========================================
# BIRTHDAY CHECK SERVICE - ENVIRONMENT VARIABLES
# ==========================================

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL="postgresql://username:password@localhost:5432/beuni_db"

# ==========================================
# REDIS & QUEUE CONFIGURATION
# ==========================================
REDIS_URL="redis://localhost:6379"
BIRTHDAY_QUEUE_NAME="birthday-queue"

# ==========================================
# WORKER CONFIGURATION
# ==========================================
# Concorrência do worker (quantos jobs simultâneos)
BIRTHDAY_CHECK_CONCURRENCY="5"

# ==========================================
# SCHEDULER & BATCH CONFIGURATION
# ==========================================
# Tamanho do lote para processar employees (evita sobrecarregar o banco)
BIRTHDAY_BATCH_SIZE="100"

# Delay entre lotes em milissegundos (controle de carga)
BIRTHDAY_BATCH_DELAY_MS="1000"

# ==========================================
# TIMEZONE & ENVIRONMENT
# ==========================================
# Fuso horário para execução dos cron jobs
TIMEZONE="America/Sao_Paulo"

# Ambiente de execução (development | production)
NODE_ENV="development"

# ==========================================
# EXAMPLE VALUES FOR DIFFERENT ENVIRONMENTS
# ==========================================

# DEVELOPMENT
# NODE_ENV="development"
# BIRTHDAY_CHECK_CONCURRENCY="3"
# BIRTHDAY_BATCH_SIZE="50"
# BIRTHDAY_BATCH_DELAY_MS="2000"

# PRODUCTION
# NODE_ENV="production"
# BIRTHDAY_CHECK_CONCURRENCY="10"
# BIRTHDAY_BATCH_SIZE="200"
# BIRTHDAY_BATCH_DELAY_MS="500"

# HIGH LOAD PRODUCTION
# NODE_ENV="production"
# BIRTHDAY_CHECK_CONCURRENCY="20"
# BIRTHDAY_BATCH_SIZE="500"
# BIRTHDAY_BATCH_DELAY_MS="100"