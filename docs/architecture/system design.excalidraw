      "updated": 1754950120295,
      "link": null,
      "locked": false,
      "text": "The simulation API returns the result of the request \nand has a configurable error rate. If an error occurs \nduring processing, BullMQ handles retrying the request \nfor that specific user.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The simulation API returns the result of the request \nand has a configurable error rate. If an error occurs \nduring processing, BullMQ handles retrying the request \nfor that specific user.",
      "autoResize": true,
      "lineHeight": 1.25
    },
