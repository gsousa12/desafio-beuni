generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(uuid())
  full_name            String
  email                String    @unique 
  hash_password        String
  created_at           DateTime  @default(now()) @db.Timestamptz 
  updated_at           DateTime? @updatedAt @db.Timestamptz 
}